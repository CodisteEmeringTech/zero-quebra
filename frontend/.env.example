# Copy to .env for local builds, or set as Railway environment variables.

# Public URL of the backend API service. In dev (npm run dev) leave empty —
# Vite proxies /api and /ws to localhost:4321 automatically.
# In production (Railway / Vercel / etc.), set to the backend's public URL.
# Example: https://zero-quebra-backend.up.railway.app
VITE_API_BASE_URL=
