# Copy to .env and fill in values for local development.
# In Railway, set these as environment variables on the backend service.

# Connection string for Postgres. Railway will inject this automatically when
# you attach a Postgres plugin (the variable will be DATABASE_URL by default).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zero_quebra?schema=public"

# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-strong-random-secret"

# Port the API + WS listen on. Railway sets PORT automatically; defaults to 4321 locally.
PORT=4321

# How often the AI decision-engine scanner re-evaluates inventory (ms).
SCANNER_INTERVAL_MS=15000

# development | production
NODE_ENV=development
